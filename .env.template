# .env.local 로 복사해서 쓴다 (cp .env.template .env.local)

# 환경: dev, staging, prod
STAGE=dev

# API 서버
API_HOST=localhost
API_PORT=8080

# gRPC (미사용, GRPC.md 참고)
# GRPC_PORT=8888

# 데이터베이스 (PostgreSQL). docker compose 안에서 API 를 띄우면 DB_HOST=db
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=myapp
DB_HOST=localhost
DB_PORT=5432

# 시작할 때 DB 마이그레이션(Up) 자동 적용. 수동으로 돌리려면 false 후 make migrate-up
MIGRATE_ON_START=true

# Redis (아직 미연결. docker compose --profile cache 로 띄운다)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis-password

# 비밀키. 비어 있거나 길이가 맞지 않으면 서버가 시작되지 않는다
# 32자 이상: openssl rand -hex 32
API_SECRET_KEY=
# 정확히 32자: openssl rand -hex 16
CURSOR_SECRET=

# 값이 있으면 /api/v1 요청에 X-API-Key 헤더를 요구한다. 비우면 검사하지 않는다
API_X_API_KEY=

# 프론트 출처 (쉼표 구분). CORS 와 CSRF 신뢰 출처로 쓴다. dev 에서 비우면 localhost:3000/5173 허용
# 예: CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# 앞단 프록시 수. 0: 직접 노출, 1: ALB/nginx 하나 뒤, 2: CloudFront → ALB
# 잘못 설정하면 클라이언트가 IP를 위조해 rate limit 을 우회할 수 있다
TRUSTED_PROXY_HOPS=0

# 주기 작업(cron) 실행 여부
JOBS_ENABLED=false

# 외부 API KEY
IP_INFO_TOKEN=

# 구글 이메일 (Gmail SMTP, 비밀번호는 구글 계정의 앱 비밀번호)
SMTP_USERNAME=
SMTP_PASSWORD=

# 스웨거 basic auth (dev 에서만 /swagger/* 노출). 비우면 스웨거 접근 불가
SWAGGER_ID=
SWAGGER_PASSWORD=
